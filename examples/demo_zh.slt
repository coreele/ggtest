# GGTEST 功能展示（sqllogictest 格式）
#
# 覆盖公开记录类型、期望形态与 PostgreSQL PL/pgSQL。
# 与 examples/demo.slt 对等（英文注释版）。
#
# SQLite（若当前目录 .env 指定了其他引擎，请显式传 --engine）：
#   ./bin/ggtest --engine sqlite --url jdbc:sqlite::memory: examples/demo_zh.slt
#
# PostgreSQL（全部章节包含 PL/pgSQL）：
#   ./bin/ggtest --engine postgres \
#     --url 'jdbc:postgresql://localhost:5432/postgres' \
#     --user postgres [--password ...] \
#     examples/demo_zh.slt

# --- 准备 ---
statement ok
DROP TABLE IF EXISTS items;

statement ok
CREATE TABLE items(id INTEGER, name TEXT, price REAL)

statement ok
INSERT INTO items VALUES
  (2, 'banana', 0.5),
  (1, 'apple', 1.25),
  (3, 'cherry', 3.0),
  (4, '', 9.0),
  (5, NULL, NULL)

# --- 类型串 I / T / R + 排序模式 ---

# T + rowsort：引擎返回顺序会按字典序重排
query T rowsort
SELECT name FROM items WHERE id <= 3
----
apple
banana
cherry

# I + nosort：顺序必须与 ORDER BY 一致
query I nosort
SELECT id FROM items WHERE id <= 3 ORDER BY id
----
1
2
3

# R：REAL 格式化为 %.3f
query R nosort
SELECT price FROM items WHERE id <= 3 ORDER BY id
----
1.250
0.500
3.000

# valuesort：展开全部单元格后再按字符串排序
query II valuesort
SELECT id, CAST(price AS INTEGER) FROM items WHERE id IN (1, 2) ORDER BY id
----
0
1
1
2

# --- NULL 与 (empty) ---

query T nosort
SELECT name FROM items WHERE id = 4
----
(empty)

query T nosort
SELECT name FROM items WHERE id = 5
----
NULL

query R nosort
SELECT price FROM items WHERE id = 5
----
NULL

# --- 每值一行（恰 ----）与行式（query 头 separator=<delim>） ---

# 恰 ---- 永远每值一行（每个物理行 = 一个单元格）
query IIT nosort
SELECT id, 1, name FROM items WHERE id = 1
----
1
1
apple

# TEXT 含空格时整行保留为一个单元格（不会按空格拆列）
query IIT nosort
SELECT 1, 1, 'hello world'
----
1
1
hello world

# 行式：在 query 头声明 separator=<delim>；token 两侧 trim
query IIT nosort separator=|
SELECT 1, 1, 'hello world'
----
1 | 1 | hello world

# 另一种分隔符（逗号）；不继承上一条的 |
query IIT nosort separator=,
SELECT 1, 1, 'hello world'
----
1, 1, hello world

# SQL 字面量转义：'' 在单元格中变为单个 '
query IIT nosort separator=|
SELECT 1, 1, 'hello ''world'
----
1 | 1 | hello 'world

# 恰 ---- 对多列整数行仍是每值一行
query III nosort
SELECT 4, 5, 6
----
4
5
6

# --- 仅执行（无 ---- 块）：跑 SQL，不做结果比对 ---
query I nosort
SELECT id FROM items WHERE id = 1

# --- label：相同 label 必须得到相同结果视图 ---
query I nosort same_id
SELECT id FROM items WHERE id = 1
----
1

query I nosort same_id
SELECT id FROM items WHERE name = 'apple'
----
1

# --- statement error：执行必须失败 ---
statement error
SELECT * FROM missing_table

# --- skipif / onlyif（引擎名大小写不敏感） ---
# sqlite：第一条跳过，第二条执行，第三条跳过。
# postgres：第一条执行（须合法），第二条跳过，第三条执行。
skipif sqlite
statement ok
SELECT 1

onlyif sqlite
statement ok
SELECT 1

onlyif postgres
statement ok
SELECT 1

# --- hash-threshold：值个数超过 N 时改用 MD5 期望 ---
hash-threshold 1

query I nosort
SELECT id FROM items WHERE id IN (1, 2) ORDER BY id
----
2 values hashing to 6ddb4095eb719e2a9f0a3f95677d24e0

# --- 清理 ---
statement ok
DROP TABLE IF EXISTS items;

# ==============================================================================
#  PostgreSQL PL/pgSQL 功能 — 需要 --engine postgres
# ==============================================================================
### 以下章节演示 PL/pgSQL：标量函数、控制流、集合返回、异常处理等。
### 全部记录带 onlyif postgres 守卫，在 SQLite 上自动跳过。

## --- 标量函数 — 基本参数与返回值 ---

onlyif postgres
statement ok
DROP FUNCTION IF EXISTS get_square(integer)

onlyif postgres
statement ok
CREATE OR REPLACE FUNCTION get_square(num integer)
RETURNS integer AS $$
BEGIN
    RETURN num * num;
END
$$ LANGUAGE plpgsql

onlyif postgres
query I
SELECT get_square(5)
----
25

onlyif postgres
query I
SELECT get_square(-3)
----
9

## --- DECLARE 局部变量 ---

onlyif postgres
statement ok
DROP FUNCTION IF EXISTS calc_discount(numeric, numeric)

onlyif postgres
statement ok
CREATE OR REPLACE FUNCTION calc_discount(price numeric, rate numeric)
RETURNS numeric AS $$
DECLARE
    discounted numeric;
BEGIN
    discounted := price - (price * rate / 100);
    RETURN discounted;
END
$$ LANGUAGE plpgsql

onlyif postgres
query RR nosort
SELECT calc_discount(100, 10), calc_discount(50, 20)
----
90.000
40.000

## --- IF / ELSIF / ELSE 条件分支 ---

onlyif postgres
statement ok
DROP FUNCTION IF EXISTS grade_score(integer)

onlyif postgres
statement ok
CREATE OR REPLACE FUNCTION grade_score(score integer)
RETURNS text AS $$
BEGIN
    IF score >= 80 THEN
        RETURN 'A';
    ELSIF score >= 60 THEN
        RETURN 'B';
    ELSE
        RETURN 'C';
    END IF;
END
$$ LANGUAGE plpgsql

onlyif postgres
query T nosort
SELECT grade_score(90)
----
A

onlyif postgres
query T nosort
SELECT grade_score(65)
----
B

onlyif postgres
query T nosort
SELECT grade_score(40)
----
C

## --- RETURN QUERY / SETOF — 返回结果集 ---

onlyif postgres
statement ok
DROP FUNCTION IF EXISTS fibonacci(integer)

onlyif postgres
statement ok
CREATE OR REPLACE FUNCTION fibonacci(lim integer)
RETURNS SETOF integer AS $$
DECLARE
    a integer := 0;
    b integer := 1;
    t integer;
BEGIN
    RETURN NEXT a;
    WHILE b <= lim LOOP
        RETURN NEXT b;
        t := a + b;
        a := b;
        b := t;
    END LOOP;
    RETURN;
END
$$ LANGUAGE plpgsql

onlyif postgres
query I nosort
SELECT * FROM fibonacci(13)
----
0
1
1
2
3
5
8
13

## --- LOOP + EXIT WHEN + CONTINUE ---

onlyif postgres
statement ok
DROP FUNCTION IF EXISTS sum_evens(integer)

onlyif postgres
statement ok
CREATE OR REPLACE FUNCTION sum_evens(n integer)
RETURNS integer AS $$
DECLARE
    i     integer := 1;
    total integer := 0;
BEGIN
    LOOP
        EXIT WHEN i > n;
        IF i % 2 <> 0 THEN
            i := i + 1;
            CONTINUE;
        END IF;
        total := total + i;
        i := i + 1;
    END LOOP;
    RETURN total;
END
$$ LANGUAGE plpgsql

onlyif postgres
query I
SELECT sum_evens(10)
----
30

onlyif postgres
query I
SELECT sum_evens(5)
----
6

## --- 默认参数值 ---

onlyif postgres
statement ok
DROP FUNCTION IF EXISTS greet(text, text)

onlyif postgres
statement ok
CREATE OR REPLACE FUNCTION greet(who text, prefix text DEFAULT 'Hello')
RETURNS text AS $$
BEGIN
    RETURN prefix || ', ' || who || '!';
END
$$ LANGUAGE plpgsql

onlyif postgres
query T nosort
SELECT greet('World')
----
Hello, World!

onlyif postgres
query T nosort
SELECT greet('GGTEST', 'Hi')
----
Hi, GGTEST!

## --- RETURNS TABLE — 行结构返回 ---

onlyif postgres
statement ok
DROP FUNCTION IF EXISTS split_name(text)

onlyif postgres
statement ok
CREATE OR REPLACE FUNCTION split_name(full_name text)
RETURNS TABLE(first text, last text) AS $$
BEGIN
    first := split_part(full_name, ' ', 1);
    last  := split_part(full_name, ' ', 2);
    RETURN NEXT;
END
$$ LANGUAGE plpgsql

onlyif postgres
query TT nosort separator=|
SELECT * FROM split_name('John Smith')
----
John | Smith

## --- 异常处理 — EXCEPTION WHEN ---

onlyif postgres
statement ok
DROP FUNCTION IF EXISTS safe_divide(numeric, numeric)

onlyif postgres
statement ok
CREATE OR REPLACE FUNCTION safe_divide(a numeric, b numeric)
RETURNS numeric AS $$
BEGIN
    RETURN a / b;
EXCEPTION
    WHEN division_by_zero THEN
        RETURN NULL;
END
$$ LANGUAGE plpgsql

onlyif postgres
query R
SELECT safe_divide(10, 2)
----
5.000

onlyif postgres
query T
SELECT CAST(safe_divide(10, 0) AS text)
----
NULL

onlyif postgres
query T
SELECT safe_divide(10, 0) IS NULL
----
t

## --- STATEMENT ERROR — 不捕获的异常会向客户端抛错 ---

onlyif postgres
statement error division by zero
SELECT 1 / 0

## --- PL/pgSQL 清理 ---

onlyif postgres
statement ok
DROP FUNCTION IF EXISTS get_square(integer)

onlyif postgres
statement ok
DROP FUNCTION IF EXISTS calc_discount(numeric, numeric)

onlyif postgres
statement ok
DROP FUNCTION IF EXISTS grade_score(integer)

onlyif postgres
statement ok
DROP FUNCTION IF EXISTS fibonacci(integer)

onlyif postgres
statement ok
DROP FUNCTION IF EXISTS sum_evens(integer)

onlyif postgres
statement ok
DROP FUNCTION IF EXISTS greet(text, text)

onlyif postgres
statement ok
DROP FUNCTION IF EXISTS split_name(text)

onlyif postgres
statement ok
DROP FUNCTION IF EXISTS safe_divide(numeric, numeric)

# --- halt：之后的记录一律跳过（不得执行） ---
halt

statement ok
INSERT INTO absent_after_halt VALUES (1)

query I nosort
SELECT id FROM absent_after_halt
----
1
