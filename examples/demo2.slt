# GGTEST expected-result forms (sqllogictest format) — separator-focused sample
#
# Full public-feature showcase: examples/demo.slt (and examples/demo_zh.slt).
#
#   ./bin/ggtest --engine sqlite --url jdbc:sqlite::memory: examples/demo2.slt
#
# Plain ---- is always value-per-line. Row-wise needs an explicit
# `separator <delim>` in the query header.

# Row-wise: split each expected line on |, tokens trimmed
query IIT nosort separator |
SELECT 1, 1, 'hello ''world'
----
1 | 1 | hello 'world

# Value-per-line: a cell may contain spaces without being split
query IIT nosort
SELECT 1, 1, 'hello world'
----
1
1
hello world

# separator is per query; this one does not inherit |
query IIT nosort separator ,
SELECT 1, 1, 'hello world'
----
1,1,hello world
