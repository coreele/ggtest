# Runtime config template for ggtest (copy to .env and fill in).
# Do not commit a real .env with credentials.
#
# Priority: CLI flags > process environment > this file.
# Test gate variables GGTEST_PG_* are NOT runtime keys.

GGTEST_URL=jdbc:sqlite::memory:
# GGTEST_URL=jdbc:postgresql://localhost:5432/ggtest
GGTEST_USER=
GGTEST_PASSWORD=
GGTEST_ENGINE=sqlite
# GGTEST_ENGINE=postgres
GGTEST_HASH_THRESHOLD=8
